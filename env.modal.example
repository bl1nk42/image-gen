# Modal deployment
MODAL_APP_NAME=agent-mcp-image-generation
MODAL_GPU=L40S
MODAL_MODEL_VOLUME=agent-mcp-models
MODAL_DATA_VOLUME=agent-mcp-image-data
COMFYUI_WORKFLOW_PATH=/data/workflows/qwen-image-api.json
# For the supplied ComfyUI canvas export, set COMFYUI_TEMPLATE=anima.
# The backend mounts /opt/templates/image_anima_preview.gui.json and converts
# it to API format before POST /prompt.
COMFYUI_TEMPLATE=anima
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLIP_MODEL=openai/clip-vit-base-patch32
VECTOR_DB_PATH=/data/vector_store
VECTOR_TABLE_NAME=memories
# Set this to the deployed Modal endpoint if the plugin host has no local model.
MODAL_EMBED_TEXT_URL=https://YOUR_MODAL_APP--embed-text-api.modal.run
MODAL_EMBED_IMAGE_URL=https://YOUR_MODAL_APP--embed-image-api.modal.run

# Hermes runtime after `modal deploy`
MODAL_BACKEND_URL=https://YOUR_MODAL_APP--generate-api.modal.run
